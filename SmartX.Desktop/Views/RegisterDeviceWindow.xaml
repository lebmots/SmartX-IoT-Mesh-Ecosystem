<Window x:Class="SmartX.Desktop.Views.RegisterDeviceWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Register IoT Device"
Height="600"
Width="600"
WindowStartupLocation="CenterOwner"
ResizeMode="NoResize"
Background="#F3F6F9">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Register Smart-X Device"
FontSize="26"
FontWeight="Bold"
Foreground="#102A43"/>

            <TextBlock Text="Add a simulated ESP32 device to the Smart-X gateway."
Margin="0,6,0,0"
Foreground="#6B7C8F"
FontSize="13"/>

        </StackPanel>

        <!-- Device ID -->
        <StackPanel Grid.Row="2">

            <TextBlock Text="Device ID"
FontWeight="SemiBold"
Foreground="#102A43"/>

            <TextBox x:Name="txtDeviceId"
Height="38"
Margin="0,6,0,0"
Padding="10"
FontSize="13"/>

        </StackPanel>

        <!-- MAC -->
        <StackPanel Grid.Row="4">

            <TextBlock Text="MAC Address"
FontWeight="SemiBold"
Foreground="#102A43"/>

            <TextBox x:Name="txtMacAddress"
Height="38"
Margin="0,6,0,0"
Padding="10"
FontSize="13"/>

        </StackPanel>

        <!-- Location -->
        <StackPanel Grid.Row="6">

            <TextBlock Text="Deployment Location"
FontWeight="SemiBold"
Foreground="#102A43"/>

            <TextBox x:Name="txtDeploymentLocation"
Height="38"
Margin="0,6,0,0"
Padding="10"
FontSize="13"/>

        </StackPanel>

        <!-- Category -->
        <StackPanel Grid.Row="8">

            <TextBlock Text="Sensor Category"
FontWeight="SemiBold"
Foreground="#102A43"/>

            <ComboBox x:Name="cmbCategory"
Height="38"
Margin="0,6,0,0"
SelectedIndex="0">

                <ComboBoxItem Content="Environmental"/>
                <ComboBoxItem Content="Power Consumption"/>
                <ComboBoxItem Content="Actuator"/>

            </ComboBox>

        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="10"
Orientation="Horizontal"
HorizontalAlignment="Right">

            <Button Content="Cancel"
Width="100"
Height="38"
Margin="0,0,12,0"
Click="btnCancel_Click"/>

            <Button Content="Register Device"
Width="150"
Height="38"
Background="#0B6E75"
Foreground="White"
FontWeight="SemiBold"
BorderThickness="0"
Click="btnRegister_Click"/>

        </StackPanel>

    </Grid>

</Window>






