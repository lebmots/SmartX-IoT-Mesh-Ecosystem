<Window x:Class="SmartX.Desktop.Views.MeshTopologyWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Smart-X | Mesh Network Topology"
Height="750"
Width="1150"
MinHeight="550"
MinWidth="850"
WindowStartupLocation="CenterScreen"
Background="#F4F6F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#18212F" Padding="25">
            <StackPanel>
                <TextBlock Text="Network Topology &amp; Mesh Routing"
Foreground="White"
FontSize="27"
FontWeight="Bold"/>

                <TextBlock Text="Smart-X | ESP32 Mesh Network Management"
Foreground="#CBD5E1"
FontSize="14"
Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <TextBlock Text="Mesh Network Overview"
FontSize="23"
FontWeight="Bold"
Foreground="#18212F"/>

                <TextBlock Text="Monitor network connections and analyse routing algorithms."
Foreground="#64748B"
Margin="0,7,0,25"/>

                <UniformGrid Columns="3" Margin="0,0,0,25">

                    <Border Background="White"
Padding="20"
Margin="0,0,10,0"
CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="TOTAL NODES"
Foreground="#64748B"/>
                            <TextBlock x:Name="txtTotalNodes"
Text="--"
FontSize="30"
FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
Padding="20"
Margin="0,0,10,0"
CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="CONNECTIONS"
Foreground="#64748B"/>
                            <TextBlock x:Name="txtConnections"
Text="--"
FontSize="30"
FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
Padding="20"
CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="NETWORK STATUS"
Foreground="#64748B"/>
                            <TextBlock x:Name="txtNetworkStatus"
Text="Not connected"
FontSize="18"
FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <Border Background="White"
CornerRadius="10"
Padding="20"
Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Mesh Nodes"
FontSize="19"
FontWeight="Bold"
Margin="0,0,0,12"/>

                        <DataGrid x:Name="dgMeshNodes"
Height="190"
AutoGenerateColumns="True"
IsReadOnly="True"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
CornerRadius="10"
Padding="20"
Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Network Connections"
FontSize="19"
FontWeight="Bold"
Margin="0,0,0,12"/>

                        <DataGrid x:Name="dgMeshConnections"
Height="190"
AutoGenerateColumns="True"
IsReadOnly="True"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
CornerRadius="10"
Padding="20">

                    <StackPanel>
                        <TextBlock Text="Routing Algorithms"
FontSize="19"
FontWeight="Bold"
Margin="0,0,0,15"/>

                        <WrapPanel>
                            <Button Content="BFS Traversal"
Width="160"
Height="42"
Margin="0,0,12,10"
IsEnabled="False"/>

                            <Button Content="Prim's MST"
Width="160"
Height="42"
Margin="0,0,12,10"
IsEnabled="False"/>

                            <Button Content="Dijkstra Path"
Width="160"
Height="42"
Margin="0,0,12,10"
IsEnabled="False"/>
                        </WrapPanel>

                        <TextBlock Text="Algorithm controls will be connected to the API in the next development step."
Foreground="#64748B"
TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>


