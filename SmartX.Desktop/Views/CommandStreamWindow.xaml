<Window x:Class="SmartX.Desktop.Views.CommandStreamWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Smart-X | Real-Time Command Stream"
Height="800"
Width="1250"
MinHeight="650"
MinWidth="1000"
WindowStartupLocation="CenterOwner"
Background="#F4F6F8">

    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#18212F"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>

        <Style x:Key="PanelHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#18212F"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#18212F" Padding="25">
            <StackPanel>
                <TextBlock Text="SMART-X | COMMAND CENTRE"
FontSize="27"
FontWeight="Bold"
Foreground="White"/>

                <TextBlock Text="Real-time telemetry, device control and predictive insights"
FontSize="14"
Foreground="#CBD5E1"
Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
VerticalScrollBarVisibility="Auto"
HorizontalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <!-- Summary cards -->
                <UniformGrid Columns="4" Margin="0,0,0,25"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

                    <Border Background="White" CornerRadius="10"
Padding="20" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Queued Telemetry"
Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="txtQueuedTelemetry"
Text="0"
Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10"
Padding="20" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Critical Alerts"
Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="txtCriticalAlerts"
Text="0"
Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10"
Padding="20" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Active Devices"
Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="txtActiveDevices"
Text="0"
Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10"
Padding="20">
                        <StackPanel>
                            <TextBlock Text="Commands Issued"
Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="txtCommandsIssued"
Text="0"
Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Telemetry stream -->
                <Border Background="White" CornerRadius="10"
Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Live Telemetry Stream"
Style="{StaticResource PanelHeading}"/>

                        <DataGrid x:Name="dgTelemetry"
Margin="0,15,0,0"
Height="200"
AutoGenerateColumns="True"
IsReadOnly="True"/>
                    </StackPanel>
                </Border>

                <!-- Device search -->


                <Border Background="White"
CornerRadius="10"
Padding="20"
Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Device Search &amp; Filtering"
Style="{StaticResource PanelHeading}"/>

                        <Grid Margin="0,15,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtDeviceSearch"
Grid.Column="0"
Height="36"
Margin="0,0,10,0"
Padding="10,7"
VerticalContentAlignment="Center"
ToolTip="Search by device ID, MAC or location"/>

                            <ComboBox x:Name="cmbCategory"
Grid.Column="1"
Height="36"
Margin="0,0,10,0"
SelectedIndex="0">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Environmental"/>
                                <ComboBoxItem Content="Power"/>
                                <ComboBoxItem Content="Actuator"/>
                            </ComboBox>

                            <ComboBox x:Name="cmbAlertState"
Grid.Column="2"
Height="36"
Margin="0,0,10,0"
SelectedIndex="0">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Disconnected"/>
                                <ComboBoxItem Content="Normal"/>
                            </ComboBox>

                            <Button Grid.Column="3"
Content="Search"
Width="90"
Height="36"
Style="{StaticResource ActionButton}"
Click="btnSearchDevices_Click"/>
                        </Grid>

                        <DataGrid x:Name="dgFilteredDevices"
Height="220"
AutoGenerateColumns="True"
IsReadOnly="True"
SelectionMode="Single"/>
                    </StackPanel>
                </Border>


                <!-- Manual commands -->
                <Border Background="White" CornerRadius="10"
Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Manual Override Commands"
Style="{StaticResource PanelHeading}"/>

                        <TextBlock Text="Select a device and issue a command."
Foreground="#64748B"
Margin="0,8,0,15"/>

                        <WrapPanel>
                            <Button x:Name="btnPumpOn"
Content="Pump ON"
Style="{StaticResource ActionButton}"
IsEnabled="False"/>

                            <Button x:Name="btnPumpOff"
Content="Pump OFF"
Style="{StaticResource ActionButton}"
IsEnabled="False"/>

                            <Button x:Name="btnRelayOn"
Content="Relay ON"
Style="{StaticResource ActionButton}"
IsEnabled="False"/>

                            <Button x:Name="btnRelayOff"
Content="Relay OFF"
Style="{StaticResource ActionButton}"
IsEnabled="False"/>

                            <Button x:Name="btnUndo"
Content="Undo Last Command"
Style="{StaticResource ActionButton}"
IsEnabled="False"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Command history -->
                <Border Background="White" CornerRadius="10"
Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Command History"
Style="{StaticResource PanelHeading}"/>

                        <DataGrid x:Name="dgCommandHistory"
Margin="0,15,0,0"
Height="180"
AutoGenerateColumns="True"
IsReadOnly="True"/>
                    </StackPanel>
                </Border>

                <!-- Recommendations -->
                <Border Background="White" CornerRadius="10"
Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Suggested Actions &amp; Automated Insights"
Style="{StaticResource PanelHeading}"/>

                        <ListBox x:Name="lstSuggestedActions"
Height="140"
Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Smart-X Part 2 | Real-Time Processing &amp; Device Management"
Foreground="#64748B"
FontSize="12"
HorizontalAlignment="Center"
Margin="0,5,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>


