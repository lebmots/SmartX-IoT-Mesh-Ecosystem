<Window x:Class="SmartX.Desktop.Views.TelemetryWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Smart-X Telemetry Dashboard"
Height="760"
Width="1180"
WindowStartupLocation="CenterScreen"
Background="#F3F6F9">

    <Window.Resources>

        <Style x:Key="SummaryCardStyle"
TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
TargetType="Button">
            <Setter Property="Background" Value="#0B6E75"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0"
Background="#102A43">

            <Grid Margin="30,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="SMART-X"
Foreground="White"
FontSize="26"
FontWeight="Bold"/>

                    <TextBlock Text="IoT Mesh Ecosystem Management Gateway"
Foreground="#B8D7E3"
FontSize="13"
Margin="0,4,0,0"/>

                </StackPanel>

                <Border Grid.Column="1"
Background="#163C52"
CornerRadius="18"
Padding="14,8"
VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse Width="10"
Height="10"
Fill="#2ECC71"
Margin="0,0,8,0"/>

                        <TextBlock Text="LIVE GATEWAY"
Foreground="White"
FontWeight="SemiBold"
VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        
        <ScrollViewer Grid.Row="1"
VerticalScrollBarVisibility="Auto">

            <Grid Margin="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                
                <StackPanel Grid.Row="0">

                    <TextBlock Text="Sensor Data Ingestion &amp; Telemetry"
FontSize="28"
FontWeight="Bold"
Foreground="#102A43"/>

                    <TextBlock Text="Monitor registered Smart-X IoT devices, health states and connectivity conditions."
Margin="0,7,0,0"
Foreground="#5D6D7E"
FontSize="14"/>

                </StackPanel>

                
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total -->
                    <Border Grid.Column="0"
Style="{StaticResource SummaryCardStyle}"
Background="#DCEAF7">

                        <StackPanel>

                            <TextBlock Text="TOTAL DEVICES"
Foreground="#486581"
FontSize="11"
FontWeight="SemiBold"/>

                            <TextBlock x:Name="txtTotalDevices"
Text="0"
Foreground="#102A43"
FontSize="28"
FontWeight="Bold"
Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- Healthy -->
                    <Border Grid.Column="1"
Style="{StaticResource SummaryCardStyle}"
Background="#DFF6E8">

                        <StackPanel>

                            <TextBlock Text="HEALTHY"
Foreground="#217A4C"
FontSize="11"
FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal"
Margin="0,5,0,0">

                                <Ellipse Width="11"
Height="11"
Fill="#2ECC71"
VerticalAlignment="Center"
Margin="0,0,8,0"/>

                                <TextBlock x:Name="txtHealthy"
Text="0"
Foreground="#145A32"
FontSize="28"
FontWeight="Bold"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- Warning -->
                    <Border Grid.Column="2"
Style="{StaticResource SummaryCardStyle}"
Background="#FFF4D6">

                        <StackPanel>

                            <TextBlock Text="WARNING"
Foreground="#9A6A00"
FontSize="11"
FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal"
Margin="0,5,0,0">

                                <Ellipse Width="11"
Height="11"
Fill="#F4B400"
VerticalAlignment="Center"
Margin="0,0,8,0"/>

                                <TextBlock x:Name="txtWarning"
Text="0"
Foreground="#8A6200"
FontSize="28"
FontWeight="Bold"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- Critical -->
                    <Border Grid.Column="3"
Style="{StaticResource SummaryCardStyle}"
Background="#FCE3E3">

                        <StackPanel>

                            <TextBlock Text="CRITICAL"
Foreground="#A83232"
FontSize="11"
FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal"
Margin="0,5,0,0">

                                <Ellipse Width="11"
Height="11"
Fill="#E74C3C"
VerticalAlignment="Center"
Margin="0,0,8,0"/>

                                <TextBlock x:Name="txtCritical"
Text="0"
Foreground="#922B21"
FontSize="28"
FontWeight="Bold"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- Disconnected -->

                    <Border Grid.Column="4"
Style="{StaticResource SummaryCardStyle}"
Background="#E8ECEF">

                        <StackPanel>

                            <TextBlock Text="DISCONNECTED"
Foreground="#4A4A4A"
FontSize="11"
FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal"
Margin="0,5,0,0">

                                <Ellipse Width="11"
Height="11"
Fill="#555555"
VerticalAlignment="Center"
Margin="0,0,8,0"/>

                                <TextBlock x:Name="txtDisconnected"
Text="0"
Foreground="#333333"
FontSize="28"
FontWeight="Bold"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- SECTION HEADER -->
                <Grid Grid.Row="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left side -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Registered Devices"
FontSize="18"
FontWeight="Bold"
Foreground="#102A43"/>

                        <TextBlock Text="Current connectivity and deployment information"
Foreground="#6B7C8F"
FontSize="12"
Margin="0,3,0,0"/>

                    </StackPanel>

                    <!-- Right side -->
                    <StackPanel Grid.Column="1"
Orientation="Horizontal"
VerticalAlignment="Center">

                        <TextBlock x:Name="txtLastRefresh"
Text="Waiting for data..."
Foreground="#6B7C8F"
FontSize="12"
VerticalAlignment="Center"
Margin="0,0,15,0"/>

                        <Button x:Name="btnRefresh"
Content="↻ Refresh Devices"
Width="160"
Height="38"
Style="{StaticResource PrimaryButtonStyle}"
Click="btnRefresh_Click"/>

                    </StackPanel>

                </Grid>

                <!-- DATA GRID -->
                <Border Grid.Row="6"
Background="White"
CornerRadius="10"
Padding="0"
BorderBrush="#D9E2EC"
BorderThickness="1">

                    <DataGrid x:Name="dgDevices"
AutoGenerateColumns="False"
IsReadOnly="True"
CanUserAddRows="False"
HeadersVisibility="Column"
GridLinesVisibility="Horizontal"
HorizontalGridLinesBrush="#E9EEF3"
RowHeight="44"
FontSize="13"
BorderThickness="0"
AlternatingRowBackground="#F8FAFC"
SelectionMode="Single">

                        <DataGrid.Resources>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
Value="#EAF1F6"/>
                                <Setter Property="Foreground"
Value="#102A43"/>
                                <Setter Property="FontWeight"
Value="SemiBold"/>
                                <Setter Property="Padding"
Value="10"/>
                                <Setter Property="BorderThickness"
Value="0"/>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding"
Value="8"/>
                                <Setter Property="BorderThickness"
Value="0"/>
                                <Setter Property="VerticalContentAlignment"
Value="Center"/>
                            </Style>

                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Device ID"
Binding="{Binding DeviceId}"
Width="130"/>

                            <DataGridTextColumn Header="MAC Address"
Binding="{Binding MacAddress}"
Width="170"/>

                            <DataGridTextColumn Header="Location"
Binding="{Binding DeploymentLocation}"
Width="*"/>

                            <DataGridTextColumn Header="Category"
Binding="{Binding CategoryText}"
Width="150"/>

                            <DataGridTextColumn Header="Health"
Binding="{Binding HealthStatusText}"
Width="145"/>

                            <DataGridTextColumn Header="Status Message"
Binding="{Binding HealthMessage}"
Width="250"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

                <!-- ANOMALY SECTION HEADER -->
                <Grid Grid.Row="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Recent Anomalies"
FontSize="18"
FontWeight="Bold"
Foreground="#102A43"/>

                        <TextBlock Text="Detected telemetry spikes and abnormal sensor readings"
Foreground="#6B7C8F"
FontSize="12"
Margin="0,3,0,0"/>

                    </StackPanel>

                    <Border Grid.Column="1"
Background="#FCE3E3"
CornerRadius="14"
Padding="12,6"
VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
Height="8"
Fill="#D64545"
Margin="0,0,7,0"/>

                            <TextBlock x:Name="txtAnomalyCount"
Text="0 anomalies"
Foreground="#B42318"
FontWeight="SemiBold"
FontSize="12"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ANOMALY DATA GRID -->
                <Border Grid.Row="10"
Background="White"
CornerRadius="10"
BorderBrush="#D9E2EC"
BorderThickness="1">

                    <DataGrid x:Name="dgAnomalies"
AutoGenerateColumns="False"
IsReadOnly="True"
CanUserAddRows="False"
HeadersVisibility="Column"
GridLinesVisibility="Horizontal"
HorizontalGridLinesBrush="#E9EEF3"
RowHeight="42"
FontSize="13"
BorderThickness="0"
AlternatingRowBackground="#F8FAFC"
SelectionMode="Single">

                        <DataGrid.Resources>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EAF1F6"/>
                                <Setter Property="Foreground" Value="#102A43"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>

                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>

                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Device ID"
Binding="{Binding DeviceId}"
Width="150"/>

                            <DataGridTextColumn Header="Metric"
Binding="{Binding Metric}"
Width="150"/>

                            <DataGridTextColumn Header="Anomaly Description"
Binding="{Binding Message}"
Width="*"/>

                            <DataGridTextColumn Header="Detected At"
Binding="{Binding DetectedAtText}"
Width="180"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>


            </Grid>

        </ScrollViewer>

    </Grid>

</Window>
